{
  "name": "bitcorn-lightning-api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true,force:true})\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.7",
    "@grpc/proto-loader": "0.8.1",
    "bech32": "2.0.0",
    "better-sqlite3": "13.2.0",
    "jose": "5.10.0",
    "ln-service": "58.1.0",
    "viem": "2.57.20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "overrides": {
    "bitcoinjs-lib": "6.1.8",
    "@grpc/grpc-js": "1.14.7"
  }
}

// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ChannelRolePanel — load > load rejected → swallowed, shown as no role (carried defect) 1`] = `
"panel: 1
<div class="panel ops" style="margin-top: 12px;">
  <div class="panel-header">
    <span class="panel-title" id="channel-role-title">
      <span aria-hidden="true" class="icon">
        "◈"
      "Channel Role"
  <div class="panel-body" style="display: flex; flex-direction: column; gap: 8px;">
    <div style="font-size: 0.8125rem; color: var(--text-3); margin-bottom: 4px;">
      "Your channel role determines how liquidity recommendations are calculated."
    <fieldset aria-labelledby="channel-role-title" class="choice choice-column">
      <div class="choice-options">
        <label class="choice-option" data-value="merchant">
          <input class="choice-input" name="channel-role" type="radio" value="merchant" prop:checked=false :disabled=false>
          <span aria-hidden="true" class="choice-icon">
            "↗"
          <span class="choice-text">
            <span class="choice-label">
              "Merchant"
            <span class="choice-desc">
              "You send payments through the hub — outbound capacity matters most"
        <label class="choice-option" data-value="farmer">
          <input class="choice-input" name="channel-role" type="radio" value="farmer" prop:checked=false :disabled=false>
          <span aria-hidden="true" class="choice-icon">
            "↙"
          <span class="choice-text">
            <span class="choice-label">
              "Farmer"
            <span class="choice-desc">
              "You receive earnings through the hub — receiving capacity matters most"
    <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
      <button class="btn btn-primary" disabled="" prop:disabled=true>
        "Save role"
calls: {"setChannelRole":[],"roleChangedEvents":0}"
`;


                  <span class="fee-rate-token">
                    "Economy ~1 sat/vB"
                  " "
                  <span class="fee-rate-token">
                    "· Normal ~5 sat/vB"
                  " "
                  <span class="fee-rate-token">
                    "· Priority ~15 sat/vB"
              <div class="connect-address">
                <label class="form-label">
                  "BitCorn's address"
                  " "
                  <span class="connect-optional">
                    "(optional)"
                <input aria-label="BitCorn's address" class="form-input" placeholder="e.g. 203.0.113.5:9735 — ask your operator" type="text" value="  203.0.113.5:9735  " prop:value="  203.0.113.5:9735  " prop:disabled=false>
                <div class="connect-hint">
                  "Enter BitCorn's address to connect, or leave it blank if you're already connected."
        <div class="connect-foot-act">
          <div class="connect-summary">
            "1,000,000 sats"

      <div class="alert info" style="margin-bottom: 0px;">
        <span class="alert-icon">
          "◈"
        <div class="alert-body">
          <div class="alert-type">
            "No hub channel"
          <div class="alert-msg">
            "Open a channel to the hub to start sending and receiving Lightning payments."
      <div style="display: flex; flex-direction: column; gap: 14px;">
        <div>
          <label class="form-label">
            "Channel Capacity"
          <div style="display: flex; gap: 8px; margin-bottom: 8px;">
            <button class="btn btn-primary" style="flex: 1 1 0%;" prop:disabled=false>
              "1M"
            <button class="btn btn-outline" style="flex: 1 1 0%;" prop:disabled=false>
              "5M"
            <button class="btn btn-outline" style="flex: 1 1 0%;" prop:disabled=false>
              "10M"
          <div style="position: relative;">
            <input aria-label="Channel Capacity" class="form-input" inputmode="numeric" style="padding-right: 42px;" type="text" value="1,000,000" prop:value="1,000,000" prop:disabled=false>
            <span style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-size: 0.75rem; color: var(--text-3); font-family: var(--mono); pointer-events: none;">
              "sats"
          <div style="font-size: 0.75rem; color: var(--text-3); margin-top: 4px;">
            "Recommended: 1M–10M sats. Minimum: 100,000 sats."
        <div style="">
          <label class="form-label">
            "Hub Address"
            " "
            <span style="color: var(--text-3); font-weight: 400;">
              "(optional)"
          <input aria-label="Hub Address" class="form-input" placeholder="e.g. 203.0.113.5:9735 — ask your operator" type="text" value="" prop:value="" prop:disabled=false>
          <div style="font-size: 0.75rem; color: var(--text-3); margin-top: 4px;">
            "Enter the hub's address to connect, or leave blank if already connected."
        <div>
          <label class="form-label">
            "Confirmation Speed"
          <div style="display: flex; gap: 6px;">
            <button style="flex: 1 1 0%; padding: 8px 6px; border-radius: 8px; cursor: pointer; border: 2px solid var(--amber); background: color-mix(in srgb, var(--amber) 10%, var(--bg-2)); text-align: center;" type="button" prop:disabled=false>
              <div style="font-size: 0.8125rem; font-weight: 600; color: var(--text);">
                "Economy"
              <div style="font-size: 0.6875rem; color: var(--text-2);">
                "1–3 hours"
              <div style="font-size: 0.6875rem; color: var(--text-3); font-family: var(--mono);">
                "~155 sats"
            <button style="flex: 1 1 0%; padding: 8px 6px; border-radius: 8px; cursor: pointer; border: 2px solid var(--border); background: var(--bg-2); text-align: center;" type="button" prop:disabled=false>
              <div style="font-size: 0.8125rem; font-weight: 600; color: var(--text);">
                "Normal"
              <div style="font-size: 0.6875rem; color: var(--text-2);">
                "~30 min"
              <div style="font-size: 0.6875rem; color: var(--text-3); font-family: var(--mono);">
                "~770 sats"
            <button style="flex: 1 1 0%; padding: 8px 6px; border-radius: 8px; cursor: pointer; border: 2px solid var(--border); background: var(--bg-2); text-align: center;" type="button" prop:disabled=false>
              <div style="font-size: 0.8125rem; font-weight: 600; color: var(--text);">
                "Priority"
              <div style="font-size: 0.6875rem; color: var(--text-2);">
                "~10 min"
              <div style="font-size: 0.6875rem; color: var(--text-3); font-family: var(--mono);">
                "~2,300 sats"
        <button class="btn btn-primary" prop:disabled=false>
          "Open Channel →"
      <div style="border-top: 1px solid var(--border); padding-top: 12px;">
        <details style="font-size: 0.75rem; color: var(--text-3);">
          <summary style="cursor: pointer; user-select: none;">
            "Technical details"
          <div style="margin-top: 8px; display: flex; flex-direction: column; gap: 4px;">
            <div style="display: flex; justify-content: space-between; gap: 12px;">
              <span style="flex-shrink: 0;">
                "Hub node ID"
              <span style="font-family: var(--mono); word-break: break-all; text-align: right;">
                <span class="ident">
                  "02b759b1552f6471599420c9aa8b7fb52c0a343ecc8a06157b452b5a3b107a1bca"
            <div style="display: flex; justify-content: space-between; gap: 12px;">
              <span style="flex-shrink: 0;">
                "Fee rates"
              <span style="font-family: var(--mono); word-break: break-all; text-align: right;">
                "Economy ~1 sat/vB · Normal ~5 sat/vB · Priority ~15 sat/vB"
portals: 1
<div aria-label="Open a channel to the hub" aria-modal="true" class="dialog-overlay" role="dialog">
  <div class="dialog-card action-confirm-card">
    <div class="dialog-title">
      "Open a channel to the hub"
    <div class="action-confirm-scroll">
      <div class="dialog-body">
        <dl style="display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 0px;">
          <div style="display: contents;">
            <dt style="opacity: 0.7;">
              "Capacity"
            <dd style="margin: 0px; font-variant-numeric: tabular-nums; word-break: break-word;">
              "1,000,000 sats"
          <div style="display: contents;">
            <dt style="opacity: 0.7;">
              "Peer"
            <dd style="margin: 0px; font-variant-numeric: tabular-nums; word-break: break-word;">
              "Bitcorn treasury hub"
        <p style="margin-top: 12px; margin-bottom: 0px; opacity: 0.85;">
          "Funding a channel is an on-chain transaction. The mining fee is spent whether or not you close the channel later."
      <div class="dialog-body" role="alert" style="margin-top: 12px; border-top: 1px solid var(--border-hi); padding-top: 12px;">
        <strong>
          "This is a bug — nothing was sent"
        <p style="margin: 6px 0px 0px;">
          "The confirmation did not match the details of the request, so the action was refused and no funds moved. Repeating it will fail the same way. This node's dashboard and API disagree about this action — most likely one of them updated and the other did not."
        <p style="margin: 6px 0px 0px; opacity: 0.85;">
          "If the dashboard was just updated, reload the page. If it keeps happening, the API and web versions differ — check them in Settings."
    <div style="display: flex; gap: 10px; margin-top: 16px;">
      <button class="btn btn-outline" style="flex: 1 1 0%;" prop:disabled=false>
        "Close"
calls: {"openMemberChannel":[[{"capacity_sats":1000000}]],"getTreasuryInfo":1}"
`;


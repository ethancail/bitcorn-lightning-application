exports[`ConnectToHub, the no-channel call site (MemberDashboard :731) > state 1 — peered to the hub 1`] = `
"regions: 1
<div class="panel ops fade-in span-all">
  <div class="panel-body">
    <div class="connect-card">
      <header class="connect-head">
        <div class="connect-head-text">
          <h2 class="connect-title">
            "Connect to BitCorn"
          <p class="connect-lead">
            "One connection to BitCorn carries all your Lightning payments. It's paid for from your node's bitcoin."
        <span class="connect-reach connect-reach-reachable">
          <span aria-hidden="true" class="connect-dot">
          "BitCorn reachable"
      <div class="connect-cols">
        <section class="connect-col">
          <div class="form-label" id=":r:-size">
            "How big"
          <div class="connect-sizes">
            <fieldset aria-labelledby=":r:-size" class="choice choice-row">
              <div class="choice-options">
                <label class="choice-option checked" data-value="1m">
                  <input checked="" class="choice-input" name=":r:-size-choice" type="radio" value="1m" prop:value="1m" prop:checked=true prop:disabled=false>
                  <span class="choice-text">
                    <span class="choice-label">
                      <span class="amount amount-inline" data-sats="1000000">
                        <span class="amount-figure" data-line="usd">
                          "$600.00"
                        <span class="amount-sub" data-line="sats">
                          "1,000,000 sats"
                <label class="choice-option" data-value="5m">
                  <input class="choice-input" name=":r:-size-choice" type="radio" value="5m" prop:value="5m" prop:checked=false prop:disabled=false>
                  <span class="choice-text">
                    <span class="choice-label">
                      <span class="amount amount-inline" data-sats="5000000">
                        <span class="amount-figure" data-line="usd">
                          "$3,000.00"
                        <span class="amount-sub" data-line="sats">
                          "5,000,000 sats"
                <label class="choice-option" data-value="10m">
                  <input class="choice-input" name=":r:-size-choice" type="radio" value="10m" prop:value="10m" prop:checked=false prop:disabled=false>
                  <span class="choice-text">
                    <span class="choice-label">
                      <span class="amount amount-inline" data-sats="10000000">
                        <span class="amount-figure" data-line="usd">
                          "$6,000.00"
                        <span class="amount-sub" data-line="sats">
                          "10,000,000 sats"
          <div class="connect-box">
            <div class="connect-input">
              <input aria-label="Connection size in sats" class="form-input" inputmode="numeric" type="text" value="1,000,000" prop:value="1,000,000" prop:disabled=false>
              <span class="connect-unit">
                "sats"
            <div class="connect-box-usd">
              "$600.00"
          <div class="connect-hint">
            "Recommended: 1M–10M sats. Minimum: 100,000 sats."
        <section class="connect-col">
          <div class="form-label" id=":r:-speed">
            "How fast"
          <fieldset aria-labelledby=":r:-speed" class="choice choice-row">
            <div class="choice-options">
              <label class="choice-option checked" data-value="economy">
                <input checked="" class="choice-input" name=":r:-speed-choice" type="radio" value="economy" prop:value="economy" prop:checked=true prop:disabled=false>
                <span class="choice-text">
                  <span class="choice-label">
                    "Economy"
                  <span class="choice-desc">
                    "about 30–95 min"
                  <span class="choice-meta">
                    <span class="amount amount-inline" data-sats="155">
                      <span class="amount-figure" data-line="usd">
                        "about "
                        "$0.09"
                      <span class="amount-sub" data-line="sats">
                        "~155 sats"
              <label class="choice-option" data-value="normal">
                <input class="choice-input" name=":r:-speed-choice" type="radio" value="normal" prop:value="normal" prop:checked=false prop:disabled=false>
                <span class="choice-text">
                  <span class="choice-label">
                    "Normal"
                  <span class="choice-desc">
                    "about 10–55 min"
                  <span class="choice-meta">
                    <span class="amount amount-inline" data-sats="775">
                      <span class="amount-figure" data-line="usd">
                        "about "
                        "$0.47"
                      <span class="amount-sub" data-line="sats">
                        "~775 sats"
              <label class="choice-option" data-value="priority">
                <input class="choice-input" name=":r:-speed-choice" type="radio" value="priority" prop:value="priority" prop:checked=false prop:disabled=false>
                <span class="choice-text">
                  <span class="choice-label">
                    "Priority"
                  <span class="choice-desc">
                    "about 1–25 min"
                  <span class="choice-meta">
                    <span class="amount amount-inline" data-sats="2325">
                      <span class="amount-figure" data-line="usd">
                        "about "
                        "$1.40"
                      <span class="amount-sub" data-line="sats">
                        "~2,325 sats"
      <footer class="connect-foot">
        <div class="connect-foot-tech">
          <details style="font-size: 0.75rem; color: var(--text-3);">
            <summary style="cursor: pointer; user-select: none;">
              "Technical details"
            <div style="margin-top: 8px; display: flex; flex-direction: column; gap: 4px;">
              <div style="display: flex; justify-content: space-between; gap: 12px;">
                <span style="flex-shrink: 0;">
                  "BitCorn's node ID"
                <span style="font-family: var(--mono); word-break: break-all; text-align: right;">
                  <span class="ident">
                    "02b759b1552f6471599420c9aa8b7fb52c0a343ecc8a06157b452b5a3b107a1bca"
              <div style="display: flex; justify-content: space-between; gap: 12px;">
                <span style="flex-shrink: 0;">
                  "Fee rates"
                <span style="font-family: var(--mono); word-break: break-all; text-align: right;">
                  <span class="fee-rate-token">
                    "Economy ~1 sat/vB"
                  " "
                  <span class="fee-rate-token">
                    "· Normal ~5 sat/vB"
                  " "
                  <span class="fee-rate-token">
                    "· Priority ~15 sat/vB"
        <div class="connect-foot-act">
          <div class="connect-summary">
            "1,000,000 sats"
            " · network fee about $0.09"
          <button class="btn btn-primary" prop:disabled=false>
            "Connect to BitCorn →"
portals: 0
calls: {"openMemberChannel":[],"getTreasuryInfo":1}"
`;


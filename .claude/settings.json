{
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(git -C * push)",
      "Bash(git -C * push *)",
      "Bash(git -c * push)",
      "Bash(git -c * push *)",
      "Bash(gh pr create)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge:*)",
      "mcp__plugin_github_github__push_files",
      "mcp__plugin_github_github__create_or_update_file",
      "mcp__plugin_github_github__delete_file",
      "mcp__plugin_github_github__create_branch",
      "mcp__plugin_github_github__create_pull_request",
      "mcp__plugin_github_github__create_pull_request_with_copilot",
      "mcp__plugin_github_github__merge_pull_request",
      "mcp__plugin_github_github__update_pull_request_branch",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "mcp__github__create_branch",
      "mcp__github__create_pull_request",
      "mcp__github__create_pull_request_with_copilot",
      "mcp__github__merge_pull_request",
      "mcp__github__update_pull_request_branch",
      "Bash(cast send)",
      "Bash(cast send:*)",
      "Bash(cast publish)",
      "Bash(cast publish:*)",
      "Bash(cast rpc eth_send*)",
      "Bash(cast rpc * eth_send*)",
      "Bash(forge create)",
      "Bash(forge create:*)",
      "Bash(forge script --broadcast*)",
      "Bash(forge script *--broadcast*)",
      "Bash(forge script * --broadcast)",
      "Bash(wrangler deploy)",
      "Bash(wrangler deploy:*)",
      "Bash(npx wrangler deploy)",
      "Bash(npx wrangler deploy:*)",
      "Bash(wrangler publish)",
      "Bash(wrangler publish:*)",
      "Bash(npx wrangler publish)",
      "Bash(npx wrangler publish:*)",
      "Bash(wrangler secret:*)",
      "Bash(npx wrangler secret:*)",
      "Bash(wrangler versions upload)",
      "Bash(wrangler versions upload:*)",
      "Bash(npx wrangler versions upload)",
      "Bash(npx wrangler versions upload:*)",
      "Bash(wrangler versions deploy)",
      "Bash(wrangler versions deploy:*)",
      "Bash(npx wrangler versions deploy)",
      "Bash(npx wrangler versions deploy:*)",
      "Bash(wrangler rollback)",
      "Bash(wrangler rollback:*)",
      "Bash(npx wrangler rollback)",
      "Bash(npx wrangler rollback:*)",
      "Bash(wrangler delete)",
      "Bash(wrangler delete:*)",
      "Bash(npx wrangler delete)",
      "Bash(npx wrangler delete:*)",
      "Bash(npx wrangler@* deploy*)",
      "Bash(npx wrangler@* rollback*)",
      "Bash(npx wrangler@* secret*)",
      "Bash(npm run deploy)",
      "Bash(npm run deploy:*)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && { node scripts/state-snapshot.mjs --fast >/dev/null 2>&1 || echo '[state-snapshot] fast refresh failed (non-fatal) — STATE.md below may be stale or absent.'; }; cat STATE.md 2>/dev/null || echo '[state-snapshot] no STATE.md available — run: node scripts/state-snapshot.mjs'",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/verify-gate.mjs\"",
            "timeout": 300,
            "statusMessage": "verify-gate: verifying uncommitted app changes"
          }
        ]
      }
    ]
  }
}
